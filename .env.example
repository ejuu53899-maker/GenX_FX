# GENX LAN Configuration Variables (Non-secret)
GENX_LAN_HOST=192.168.1.100
GENX_LAN_PORT=8080
GENX_API_PORT=8000
GENX_DEVICE_NAME=GENX-MINIPC
GENX_ENVIRONMENT=demo
GENX_CONTROL_MODE=lan

# GENX LAN Secrets (NEVER COMMIT ACTUAL SECRETS TO GIT)
# Obtain them from GitHub Actions secrets or local secure vault:
# GENX_LAN_TOKEN=
# GENX_API_SECRET=
# GENX_SSH_PRIVATE_KEY=
# GENX_DEVICE_PASSWORD=
# GENX_WEBHOOK_SECRET=
